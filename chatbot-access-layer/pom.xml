<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>cn.edu.scut</groupId>
        <artifactId>funny-chatbot</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>chatbot-access-layer</artifactId>
    <name>chatbot-access-layer</name>
    <description>接入层进程：平台报文翻译、原始报文留档、媒体转存、协议事务。只依赖 contract，对主服务业务知识为零</description>

    <dependencies>
        <!-- 与主服务共享的唯一契约面 -->
        <dependency>
            <groupId>cn.edu.scut</groupId>
            <artifactId>chatbot-contract</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- Stream 消费与投递回执 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <!-- 原始报文留档写 MySQL -->
        <dependency>
            <groupId>org.mybatis.spring.boot</groupId>
            <artifactId>mybatis-spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- OpenTelemetry API 层，SDK 由 -javaagent 提供 -->
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-api</artifactId>
        </dependency>
        <!--
          测试域 SDK（版本根 pom 托管，与 api 同线）：集成测试 JVM 无 javaagent，测试基类全局注册
          内存版 SDK 模拟生产挂 agent 的形态——EventTranslator 显式开 Span 的路径产生有效
          traceparent，TraceContinuityIT 的 traceId 贯穿断言依赖它。
        -->
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-sdk</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.opentelemetry.instrumentation</groupId>
            <artifactId>opentelemetry-logback-appender-1.0</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- 异步断言一律 Awaitility（宪法第七条：禁 Thread.sleep）。版本 Boot 托管 -->
        <dependency>
            <groupId>org.awaitility</groupId>
            <artifactId>awaitility</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- 单元测试用 Spock（设计方案 4.1.3：单元 Spock / 集成 JUnit 5，同跑 JUnit Platform） -->
        <dependency>
            <groupId>org.spockframework</groupId>
            <artifactId>spock-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.groovy</groupId>
            <artifactId>groovy</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- 集成测试真容器（宪法第七条：禁 H2 / 内嵌 Redis 替身）。Redis 用核心包 GenericContainer 起 -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>mysql</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- 接入隔离 ArchUnit 规则（宪法第五条） -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
          假 NapCat 的内嵌 WS 服务端由 Spring Boot 内嵌 WebServer 承载（设计方案 4.1.2）：
          TomcatServletWebServerFactory / WsSci / javax.websocket API 均已由
          spring-boot-starter-web → spring-boot-starter-tomcat 传递引入（spring-boot 主 jar +
          tomcat-embed-websocket），零新增依赖，此处注释说明来源，不重复声明。
        -->
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
