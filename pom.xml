<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>2.7.18</version>
        <relativePath/>
    </parent>

    <groupId>cn.edu.scut</groupId>
    <artifactId>funny-chatbot</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>funny-chatbot</name>
    <description>AI Agent对话系统</description>

    <developers>
        <developer>
            <name>Xi-Han</name>
        </developer>
    </developers>

    <modules>
        <module>chatbot-contract</module>
        <module>chatbot-access-layer</module>
        <module>chatbot-agent-core</module>
        <module>chatbot-sandbox-executor</module>
    </modules>
    <!-- chatbot-admin-web 是独立的 npm 工程（Vue3 + TS），不进 Maven 构建 -->

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- 以下均为 Boot 不托管、需要本工程手动锁定的版本，来源：设计方案 3.1.2 依赖矩阵 -->
        <mybatis-spring-boot.version>2.3.2</mybatis-spring-boot.version>
        <elasticsearch-java.version>8.11.4</elasticsearch-java.version>
        <opentelemetry.version>1.34.1</opentelemetry.version>
        <!--
          OTel logback appender 不跟随 opentelemetry-api 的版本节奏：Maven Central 上
          该 artifact 没有 1.34.x（1.x 线到 1.33.6-alpha 为止，之后转入 2.x 线）。
          方案 3.1.2 写的「appender 版本同 1.34.x」无法按字面落地，此处锁 1.x 线
          最后一版，与 api 1.34.1 同期、方法面兼容。
        -->
        <opentelemetry-logback-appender.version>1.33.6-alpha</opentelemetry-logback-appender.version>
        <docker-java.version>3.3.6</docker-java.version>
        <archunit-junit5.version>1.2.1</archunit-junit5.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- 内部模块 -->
            <dependency>
                <groupId>cn.edu.scut</groupId>
                <artifactId>chatbot-contract</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- ORM：原生 MyBatis（禁 MyBatis-Plus），2.3.2 是适配 Boot 2.7 的最后一条稳定线 -->
            <dependency>
                <groupId>org.mybatis.spring.boot</groupId>
                <artifactId>mybatis-spring-boot-starter</artifactId>
                <version>${mybatis-spring-boot.version}</version>
            </dependency>

            <!-- 观测查询聚合与索引初始化（ES 8.x Java 客户端，手动指定版本） -->
            <dependency>
                <groupId>co.elastic.clients</groupId>
                <artifactId>elasticsearch-java</artifactId>
                <version>${elasticsearch-java.version}</version>
            </dependency>

            <!-- OpenTelemetry：只引 API 层，SDK 由 -javaagent 挂载提供 -->
            <dependency>
                <groupId>io.opentelemetry</groupId>
                <artifactId>opentelemetry-api</artifactId>
                <version>${opentelemetry.version}</version>
            </dependency>
            <dependency>
                <groupId>io.opentelemetry.instrumentation</groupId>
                <artifactId>opentelemetry-logback-appender-1.0</artifactId>
                <version>${opentelemetry-logback-appender.version}</version>
            </dependency>

            <!-- 沙箱执行服务的容器生命周期控制 -->
            <dependency>
                <groupId>com.github.docker-java</groupId>
                <artifactId>docker-java</artifactId>
                <version>${docker-java.version}</version>
            </dependency>
            <dependency>
                <groupId>com.github.docker-java</groupId>
                <artifactId>docker-java-transport-httpclient5</artifactId>
                <version>${docker-java.version}</version>
            </dependency>

            <!-- 包依赖规约测试（ArchUnit 四条规则，设计方案 3.1.3） -->
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit-junit5</artifactId>
                <version>${archunit-junit5.version}</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

</project>
