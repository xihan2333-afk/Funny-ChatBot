<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>2.7.18</version>
        <relativePath/>
    </parent>

    <groupId>cn.edu.scut</groupId>
    <artifactId>funny-chatbot</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>funny-chatbot</name>
    <description>AI Agent对话系统</description>

    <developers>
        <developer>
            <name>Xi-Han</name>
        </developer>
    </developers>

    <modules>
        <module>chatbot-contract</module>
        <module>chatbot-access-layer</module>
        <module>chatbot-agent-core</module>
        <module>chatbot-sandbox-executor</module>
    </modules>
    <!-- chatbot-admin-web 是独立的 npm 工程（Vue3 + TS），不进 Maven 构建 -->

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- 以下均为 Boot 不托管、需要本工程手动锁定的版本，来源：设计方案 3.1.2 依赖矩阵 -->
        <mybatis-spring-boot.version>2.3.2</mybatis-spring-boot.version>
        <elasticsearch-java.version>8.11.4</elasticsearch-java.version>
        <opentelemetry.version>1.34.1</opentelemetry.version>
        <!--
          OTel logback appender 不跟随 opentelemetry-api 的版本节奏：Maven Central 上
          该 artifact 没有 1.34.x（1.x 线到 1.33.6-alpha 为止，之后转入 2.x 线）。
          方案 3.1.2 写的「appender 版本同 1.34.x」无法按字面落地，此处锁 1.x 线
          最后一版，与 api 1.34.1 同期、方法面兼容。
        -->
        <opentelemetry-logback-appender.version>1.33.6-alpha</opentelemetry-logback-appender.version>
        <docker-java.version>3.3.6</docker-java.version>
        <archunit-junit5.version>1.2.1</archunit-junit5.version>
        <!-- 测试域版本（设计方案 4.1.3）：Groovy 4.0.15 起完整支持 Java 21，与 Lombok 1.18.30+ 同属一条版本纪律 -->
        <groovy4.version>4.0.15</groovy4.version>
        <spock.version>2.3-groovy-4.0</spock.version>
        <!--
          Testcontainers 1.19.x（依赖矩阵原登记线）内嵌 docker-java 3.3，按旧 API 版本协商，
          对开发机 Docker 29（MinAPIVersion=1.44）探测失败（Could not find a valid Docker environment）。
          升至 1.20 线（docker-java 3.4，API 协商兼容 1.44+）——属兼容性必要演进，非功能变更。
        -->
        <testcontainers.version>1.20.6</testcontainers.version>
        <gmavenplus-plugin.version>3.0.2</gmavenplus-plugin.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- 内部模块 -->
            <dependency>
                <groupId>cn.edu.scut</groupId>
                <artifactId>chatbot-contract</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- ORM：原生 MyBatis（禁 MyBatis-Plus），2.3.2 是适配 Boot 2.7 的最后一条稳定线 -->
            <dependency>
                <groupId>org.mybatis.spring.boot</groupId>
                <artifactId>mybatis-spring-boot-starter</artifactId>
                <version>${mybatis-spring-boot.version}</version>
            </dependency>

            <!-- 观测查询聚合与索引初始化（ES 8.x Java 客户端，手动指定版本） -->
            <dependency>
                <groupId>co.elastic.clients</groupId>
                <artifactId>elasticsearch-java</artifactId>
                <version>${elasticsearch-java.version}</version>
            </dependency>

            <!-- OpenTelemetry：运行时只引 API 层，SDK 由 -javaagent 挂载提供 -->
            <dependency>
                <groupId>io.opentelemetry</groupId>
                <artifactId>opentelemetry-api</artifactId>
                <version>${opentelemetry.version}</version>
            </dependency>
            <!--
              OpenTelemetry SDK 仅测试域使用：集成测试 JVM 无 javaagent，测试基建全局注册内存版
              SDK 模拟生产挂 agent 的形态（EventTranslator 显式开 Span 的路径才能产生有效
              traceparent，TraceContinuityIT 的 traceId 贯穿断言依赖它）。版本与 api 同线。
            -->
            <dependency>
                <groupId>io.opentelemetry</groupId>
                <artifactId>opentelemetry-sdk</artifactId>
                <version>${opentelemetry.version}</version>
            </dependency>
            <dependency>
                <groupId>io.opentelemetry.instrumentation</groupId>
                <artifactId>opentelemetry-logback-appender-1.0</artifactId>
                <version>${opentelemetry-logback-appender.version}</version>
            </dependency>

            <!-- 沙箱执行服务的容器生命周期控制 -->
            <dependency>
                <groupId>com.github.docker-java</groupId>
                <artifactId>docker-java</artifactId>
                <version>${docker-java.version}</version>
            </dependency>
            <dependency>
                <groupId>com.github.docker-java</groupId>
                <artifactId>docker-java-transport-httpclient5</artifactId>
                <version>${docker-java.version}</version>
            </dependency>

            <!-- 包依赖规约测试（ArchUnit 四条规则，设计方案 3.1.3） -->
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit-junit5</artifactId>
                <version>${archunit-junit5.version}</version>
                <scope>test</scope>
            </dependency>

            <!-- ===== 测试域版本锁定（设计方案 4.1.3）===== -->
            <!-- Groovy：显式声明 4.0.15 覆盖 spock-core 传递的旧版本（Java 21 支持纪律） -->
            <dependency>
                <groupId>org.apache.groovy</groupId>
                <artifactId>groovy</artifactId>
                <version>${groovy4.version}</version>
            </dependency>
            <!-- Spock 单元测试框架（运行在 JUnit Platform 上，与 JUnit 5 集成测试同一次构建出同一份报告） -->
            <dependency>
                <groupId>org.spockframework</groupId>
                <artifactId>spock-core</artifactId>
                <version>${spock.version}</version>
            </dependency>
            <!-- Testcontainers：集成测试的 MySQL / Redis 真容器（Redis 无官方模块，用核心包的 GenericContainer） -->
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${testcontainers.version}</version>
            </dependency>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>mysql</artifactId>
                <version>${testcontainers.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <!--
              Groovy（Spock）测试源码编译：src/test/groovy 下的用例编译成 class 后由 surefire 执行。
              没有 groovy 源码的模块（contract / agent-core 现状）自动跳过，不产生副作用。
            -->
            <plugin>
                <groupId>org.codehaus.gmavenplus</groupId>
                <artifactId>gmavenplus-plugin</artifactId>
                <version>${gmavenplus-plugin.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>compileTests</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!--
              集成测试分层（设计方案 4.1.3）：*IT.java / *IT.groovy 由 failsafe 在 integration-test 与
              verify 阶段执行（需要 Docker 起 Testcontainers 真容器），与 surefire 跑的 *Test 单元测试分开。
              版本继承 Boot 2.7.18 托管（2.22.2）。
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <includes>
                        <include>**/*IT.java</include>
                        <include>**/*IT.groovy</include>
                    </includes>
                    <!--
                      Testcontainers 内嵌 docker-java 按默认 API 1.32 发请求，Docker 29
                      （MinAPIVersion=1.44）会拒绝（client version 1.32 is too old）——显式声明
                      API 1.44，环境约束随之确立：跑集成测试的 Docker ≥ 25（2024-01 起支持 1.44）。
                    -->
                    <argLine>-Dapi.version=1.44</argLine>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
