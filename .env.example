# Funny-ChatBot 部署层环境变量样例（复制为 .env 后按环境填写；改值需重启进程）
# 配置归层判定：改了要重启的进本文件，运行期热变更的归管理平台（设计方案 3.4.7）

# ===== 协议端（OneBot 11 正向 WS）=====
# 接入层主动连接的协议端地址；换协议端实现（NapCat 末版 / 社区 fork / 其他 OneBot 11 实现）只改这里
NAPCAT_WS_URL=ws://localhost:3001/
# 协议端鉴权令牌（对应 onebot11.json 的 token；协议端未设则留空）
ONEBOT_ACCESS_TOKEN=
# 期望的 bot QQ 号（接入层连接后 get_login_info 核对，不一致告警；留空跳过核对）
ACCESS_EXPECTED_BOT_ID=

# ===== MySQL（raw_event_log 留档）=====
CHATBOT_MYSQL_URL=jdbc:mysql://localhost:3306/funnychat?useUnicode=true&characterEncoding=utf8&connectionTimeZone=Asia/Shanghai
CHATBOT_MYSQL_USERNAME=root
CHATBOT_MYSQL_PASSWORD=

# ===== Redis（Stream 双流）=====
CHATBOT_REDIS_HOST=localhost
CHATBOT_REDIS_PORT=6379

# ===== 接入层可选项 =====
# 媒体转存根目录（compose 部署时挂载卷；本地开发默认 ./data/media）
# ACCESS_MEDIA_STORE_ROOT=./data/media
# 雪花发号器机器号（默认 2；与 agent-core 的默认 1 区分，同机部署不撞号）
# ACCESS_WORKER_ID=2

# ===== 观测栈（005-observability-safety：OTLP 导出与 ES 查询）=====
# OTLP gRPC 导出地址：事件桥自建 SDK 与 javaagent 的 Span/日志统一指向 Collector
# （compose 部署填 http://otel-collector:4317；本地无 Collector 时留空并关开关）
CHATBOT_OTLP_ENDPOINT=
# 观测导出总开关（本地开发无 Collector 时置 false——自建 SDK 降级 noop，零开销）
CHATBOT_OTLP_ENABLED=true
# ES 查询数据落点（管理平台链路/日志/指标查询经主服务转发；浏览器不直连 ES）
CHATBOT_ES_URL=http://localhost:9200
CHATBOT_ES_USERNAME=elastic
# 生产必须改掉 compose 默认口令（elasticsearch 服务的 ELASTIC_PASSWORD 同值）
CHATBOT_ES_PASSWORD=
# javaagent 挂载时的标准 OTLP 环境变量（与 CHATBOT_OTLP_ENDPOINT 同址；挂 agent 才生效）
OTEL_EXPORTER_OTLP_ENDPOINT=

# ===== 管理平台初始口令（US9：admin_account 首启种子，must_change 强制改密）=====
CHATBOT_ADMIN_INIT_USERNAME=admin
# 首次启动写入 bcrypt 哈希；登录后强制改密。生产部署必须设置强口令
CHATBOT_ADMIN_INIT_PASSWORD=
