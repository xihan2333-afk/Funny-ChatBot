# 管理平台前端多阶段构建：Node 构建静态资源 + Nginx 托管与 /api/management/ 反代。
# 构建命令在仓库根执行：
#   docker build -f deploy/Dockerfile.admin-web -t funny-chatbot/admin-web:dev .

# ===== 构建层：Node 22 =====
FROM node:22-alpine AS builder
WORKDIR /build

ARG NPM_REGISTRY=https://registry.npmmirror.com
RUN if [ -n "$NPM_REGISTRY" ]; then npm config set registry "$NPM_REGISTRY"; fi

# 先拷依赖清单再拷源码：依赖安装层可被 Docker 缓存复用
COPY chatbot-admin-web/package.json chatbot-admin-web/package-lock.json ./
RUN npm ci

COPY chatbot-admin-web/ ./
RUN npm run build

# ===== 运行层：Nginx =====
FROM nginx:1.27-alpine
COPY --from=builder /build/dist /usr/share/nginx/html
COPY chatbot-admin-web/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
